# Generated outputs
Plot/*.pdf
*.npy
*.npz
*.h5
*.hdf5
*.pkl
*.pickle
*.bpa

# Large data files
*.csv

# Vaibify logs
.vaibify/logs/

# Python
__pycache__/
*.pyc

# OS
.DS_Store

# Crash artifacts and editor/tool backups
**/core
*.bak

# Superseded / archived working directories
*.old/
*_old/

# Vaibify host-managed runtime state (not canonical, regenerated per session)
.vaibify/container_mtime_cache.json
.vaibify/syncStatus.json

# vconverge scratch space
**/.vconverge_tmp/

# Regenerable model outputs (not source): maxlev rewrites *_maxlev.in with the
# best-fit parameters each run; vplanet writes *.forward; vconverge writes the
# prior-index byproduct.
*_maxlev.in
*.forward
xuv_PriorIndicies.json

# vspace sweep-template inputs — regenerable sweep definitions, not tracked as
# source (the sweep outputs are treated as archived data). See note to researcher.
vspace.in

# Stray / non-canonical plot artifacts (no figure-compare standard references them)
Plot/*_standard.png
Plot/test_aspect.png
FfdAgeComparison/--samples.png

# Redundant text dumps of the flare MCMC samples (canonical form is the .npy)
KeplerFfdCorner/flare_mcmc_samples.txt
KeplerFfdCorner/flare_mcmc_samples_param_names.txt

