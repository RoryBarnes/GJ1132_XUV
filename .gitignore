# Generated outputs
Plot/*.pdf
*.npy
*.npz
*.h5
*.hdf5
*.pkl
*.pickle
*.bpa

# Large data files
*.csv

# Vaibify logs
.vaibify/logs/

# Python
__pycache__/
*.pyc

# OS
.DS_Store

# Crash artifacts and editor/tool backups
**/core
*.bak

# Superseded / archived working directories
*.old/
*_old/

# Vaibify host-managed runtime state (not canonical, regenerated per session)
.vaibify/container_mtime_cache.json
.vaibify/syncStatus.json

# vconverge scratch space (both spellings occur)
**/.vconverge_tmp/
**/vconverge_tmp/

# MCMC fit logs (transient) and cached MUSCLES SED downloads (regenerable)
**/fitLog_*.txt
MUSCLESBandConversion/seds/

# Regenerable model outputs (not source): maxlev rewrites *_maxlev.in with the
# best-fit parameters each run; vplanet writes *.forward; vconverge writes the
# prior-index byproduct.
*_maxlev.in
*.forward
xuv_PriorIndicies.json

# Generated Engle coefficient prior tables (regenerated each run from the
# canonical joint chains; the vspace.in rules that consume them ARE tracked)
**/engle_xuv_priors.txt

# Stray / non-canonical plot artifacts (no figure-compare standard references them)
Plot/*_standard.png
Plot/test_aspect.png
FFDAgeComparison/--samples.png

# Redundant text dumps of the flare MCMC samples (canonical form is the .npy)
KeplerFFDCorner/flare_mcmc_samples.txt
KeplerFFDCorner/flare_mcmc_samples_param_names.txt

# Stage-1 refit: calibration source data and canonical posterior products.
# The CSVs are the empirical foundation of the joint refit (verbatim Engle
# paper tables); the chains are the coefficient posteriors the catalog and
# all downstream steps consume. A fresh clone must carry them.
!JointSamplePreparation/*.csv
!JointSamplePreparation/paperTables/*.csv
!EarlyJointRefit/jointChain_*.npy
!Mid-LateJointRefit/jointChain_*.npy

# Vaibify canonical outputs — manifest-pinned; the AICS L2 GitHub mirror requires them in git
!Plot/CornerVariableSlope.pdf
!Plot/ffd_comp.pdf
!Plot/GJ1132_flares.pdf
!Plot/GJ1132_FFD_comp2.pdf
!Plot/lxuv_hist.pdf
!Plot/log_lxuv_lbol_hist.pdf
!Plot/EngleAgeHist.pdf
!BayesianPosteriors/output/dynesty_transform_final.npy
!BayesianPosteriors/output/emcee_samples.npz
!BayesianPosteriors/output/dynesty_samples.npz
!BayesianPosteriors/output/multinest_samples.npz
!BayesianPosteriors/output/ultranest_samples.npz
!Plot/sampler_comparison.pdf
!Plot/XUVEvol.pdf
!Plot/GJ1132b_CumulativeXUV_Multi.pdf
!Plot/CosmicShoreline.pdf
!Plot/GJ1132b_ErrorSourceComparison.pdf
!Plot/FitComparison.pdf
!KeplerFFDCorner/flare_mcmc_samples.npy
!Plot/CornerJointRotation_midlate_withsd.pdf
!Plot/CornerJointActivity_midlate_withsd.pdf
!Plot/CornerJointRotation_early_withsd.pdf
!Plot/CornerJointActivity_early_withsd.pdf
!Plot/EngleVsRefit_midlate_withsd.pdf
!Plot/EngleVsRefit_early_withsd.pdf
!Plot/ActivityConsistency.pdf
!Plot/XrayMeasurementValue.pdf
!Plot/AccumulationHistory.pdf

# vconverge realization directories: one vplanet run per posterior sample.
# Regenerated from the tracked vconverge.in + vspace.in, so the canonical
# record per model directory is the *.in files plus
# output/Converged_Param_Dictionary.json -- not the thousands of run dirs.
**/output/*xuv_rand_*/

# maxlev scratch run directories, named by run id
MaximumLikelihood/output/

# Vaibify test-marker backups (rotated automatically; not canonical)
.vaibify/test_markers/*.backup-*/
